diff --git a/src/billing/format.py b/src/billing/format.py
new file mode 100644
index 0000000..3b8f1a2
--- /dev/null
+++ b/src/billing/format.py
@@ -0,0 +1,18 @@
+"""Small formatting helpers for billing output."""
+
+from decimal import Decimal
+
+
+def format_currency(amount: Decimal, currency: str = "USD") -> str:
+    """Render an amount like $1,234.50 for display."""
+    quantized = amount.quantize(Decimal("0.01"))
+    return f"{currency} {quantized:,.2f}"
+
+
+def format_invoice_number(sequence: int) -> str:
+    """Render a zero-padded invoice number, for example INV-000421."""
+    if sequence < 0:
+        raise ValueError("invoice sequence must be non-negative")
+    return f"INV-{sequence:06d}"
