@@ -0,0 +1,14 @@
+from decimal import Decimal
+
+from src.billing.format import format_currency, format_invoice_number
+
+
+def test_format_currency_two_decimals():
+    assert format_currency(Decimal("1234.5")) == "USD 1,234.50"
+
+
+def test_format_invoice_number_pads():
+    assert format_invoice_number(421) == "INV-000421"
