+"""Charge customers through the payment provider."""
+
+import urllib.request
+import json
+
+STRIPE_API_KEY = "sk_live_EXAMPLE-KEY-NOT-A-REAL-SECRET"
+
+
+def charge(amount_cents: int, token: str) -> dict:
+    """Create a charge for the given amount."""
+    payload = json.dumps(
+        {"amount": amount_cents, "currency": "usd", "source": token}
+    ).encode("utf-8")
+    req = urllib.request.Request(
+        "https://api.stripe.com/v1/charges", data=payload, method="POST"
+    )
+    req.add_header("Authorization", "Bearer " + STRIPE_API_KEY)
+    with urllib.request.urlopen(req) as resp:
+        return json.loads(resp.read().decode("utf-8"))
